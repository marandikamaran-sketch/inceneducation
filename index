    function loadNext(pid) {
      const p = App.players[pid];
      const maxQ = App.mode === 'classify' ? 3 : MAX_QUESTIONS;
      if (p.qIndex >= maxQ) {
        p.done = true;
        App.orbs = App.orbs.filter(o => o.pid !== pid);
        checkComplete();
        return;
      }
      const qData = App.mode === 'classify'
        ? PyBridge.generateClassify(pid, App.grade)
        : PyBridge.generateQuestion(pid, App.grade, App.subject);
      p.currentQ = qData;
      p.qStart = performance.now();
      p.level = qData.level;
      spawnOrbs(pid, qData);
      updateHud();
      if (App.mode !== 'split') AudioFX.speak(qData.question);
    }

    function updateHud() {
      const p1 = App.players.p1, p2 = App.players.p2;
      const maxQ = App.mode === 'classify' ? 3 : MAX_QUESTIONS;
      if (App.mode !== 'split') {
        document.getElementById('s1Progress').textContent = `${App.mode === 'classify' ? 'Misi' : 'Soal'} ${Math.min(p1.qIndex + 1, maxQ)} / ${maxQ}`;
        document.getElementById('s1ProgressBar').style.width = `${((p1.qIndex + 1) / maxQ) * 100}%`;
        document.getElementById('s1Level').textContent = `Level ${p1.level}`;
        document.getElementById('s1Score').textContent = `⭐ ${p1.score}`;
        const comboEl = document.getElementById('s1Combo');
        if (p1.streak >= 2) { comboEl.textContent = `🔥 Combo x${p1.streak}`; comboEl.classList.remove('hidden'); }
        else comboEl.classList.add('hidden');
        if (p1.currentQ) document.getElementById('s1Question').textContent = p1.currentQ.question;
        document.getElementById('s1SubHint').textContent = App.mode === 'classify'
          ? 'Cubit & pilah semua gelembung ke Portal Kiri atau Portal Kanan!'
          : 'Cubit / seret gelembung jawaban ke dalam Portal Jawaban!';
      } else {
        document.getElementById('p1Progress').textContent = `${Math.min(p1.qIndex + 1, maxQ)}/${maxQ}`;
        document.getElementById('p1Score').textContent = `⭐ ${p1.score}`;
        document.getElementById('p1Question').textContent = p1.done ? 'Selesai! 🎉' : (p1.currentQ?.question || '');
        document.getElementById('p2Progress').textContent = `${Math.min(p2.qIndex + 1, maxQ)}/${maxQ}`;
        document.getElementById('p2Score').textContent = `⭐ ${p2.score}`;
        document.getElementById('p2Question').textContent = p2.done ? 'Selesai! 🎉' : (p2.currentQ?.question || '');
      }
    }

    function handleDrop(orb, portal) {
      const pid = orb.pid;
      const p = App.players[pid];
      const sec = (performance.now() - p.qStart) / 1000;
      const isRight = App.mode === 'classify' ? (orb.target === portal.id) : orb.correct;

      const res = PyBridge.recordAnswer(pid, isRight, sec);
      p.score = res.state.score;
      p.level = res.state.level;
      p.streak = res.state.streak;

      if (isRight) {
        if (res.level_up) AudioFX.levelUp(); else AudioFX.correct();
        spawnParticles(portal.x, portal.y, null, 34);
        spawnRipple(portal.x, portal.y, '#34d399');
        spawnFloatText(portal.x, portal.y - 35, res.level_up ? `LEVEL ${p.level}! 🚀` : `+${100 * p.level} ⭐`, '#34d399');
        showToast(res.feedback);

        if (App.mode === 'classify') {
          // Hapus orb yang sudah benar dipilah
          App.orbs = App.orbs.filter(o => o.id !== orb.id);
          p.qStart = performance.now();
          updateHud();
          if (App.orbs.filter(o => o.pid === pid).length === 0) {
            p.qIndex++;
            setTimeout(() => loadNext(pid), 700);
          }
        } else {
          if (p.currentQ?.exp) showToast(`${res.feedback} — ${p.currentQ.exp}`, 3200);
          p.qIndex++;
          updateHud();
          setTimeout(() => loadNext(pid), 800);
        }
      } else {
        AudioFX.wrong();
        orb.shake = 18;
        orb.y = portal.y - portal.r - orb.r - 36;
        orb.vy = -2.2;
        spawnParticles(orb.x, orb.y, '#f43f5e', 12);
        spawnFloatText(orb.x, orb.y - 25, 'Coba lagi!', '#fda4af');
        showToast(`${res.feedback} 💡 ${p.currentQ?.hint || ''}`, 3600);
        updateHud();
      }
    }

