        random.shuffle(opts)
        return json.dumps({"type": "quiz", "question": q_text, "hint": hint, "exp": exp, "options": opts, "level": lvl, "subject": "Matematika"})

    def record_answer(self, pid, is_correct, response_sec):
        st = self.states[pid]
        st["attempts"] += 1
        st["total_time"] += response_sec
        level_up = False
        if is_correct:
            st["correct"] += 1
            st["streak"] += 1
            combo_bonus = min(60, (st["streak"] - 1) * 15)
            speed_bonus = 25 if response_sec < 5.5 else 10
            st["score"] += (100 * st["level"]) + speed_bonus + combo_bonus
            if st["streak"] >= 2 and st["level"] < 3:
                st["level"] += 1
                level_up = True
                feedback = f"Hebat! Combo {st['streak']}x — Naik ke Level {st['level']}!"
            else:
                feedback = f"Benar! +{100*st['level']+speed_bonus+combo_bonus} poin 🎉"
        else:
            st["streak"] = 0
            if st["level"] > 1:
                st["level"] -= 1
            feedback = "Belum tepat, yuk coba lagi!"

        acc = round((st["correct"] / max(1, st["attempts"])) * 100)
        return json.dumps({"state": st, "accuracy": acc, "feedback": feedback, "level_up": level_up})

    def get_summary(self, pid, grade, subject):
        st = self.states[pid]
        acc = round((st["correct"] / max(1, st["attempts"])) * 100)
        avg_t = round(st["total_time"] / max(1, st["attempts"]), 1)
        if acc >= 85:
            stars = 3
            rec = f"Penguasaan luar biasa pada {subject.upper()} Kelas {grade}! Akurasi {acc}% dengan rata-rata reaksi {avg_t} detik di Level {st['level']}."
        elif acc >= 60:
            stars = 2
            rec = f"Bagus sekali! Akurasi {acc}% (reaksi {avg_t}d). Latih sedikit lagi soal Level {st['level']} agar makin lancar."
        else:
            stars = 1
            rec = f"Semangat terus! Akurasi {acc}%. Manfaatkan tombol Petunjuk (💡) dan ulangi perlahan untuk memperkuat pemahaman."
        return json.dumps({"score": st["score"], "accuracy": acc, "avg_time": avg_t, "level": st["level"], "stars": stars, "recommendation": rec})

