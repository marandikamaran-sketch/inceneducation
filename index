        this.log("Memuat Pyodide (Python 3 WebAssembly) secara asinkron...");
        let tries = 0;
        while (typeof loadPyodide === 'undefined' && tries < 60) {
          await new Promise(r => setTimeout(r, 300));
          tries++;
        }
        if (typeof loadPyodide === 'undefined') {
          this.setBadge("JS Fallback", "bg-sky-400");
          this.log("Pyodide CDN tidak terjangkau — Menggunakan JS Fallback identik.");
          return;
        }
        try {
          this.pyodide = await loadPyodide();
          await this.pyodide.runPythonAsync(PYTHON_ENGINE_CODE);
          this.ready = true;
          this.setBadge("Python Aktif", "bg-emerald-400");
          document.getElementById('pyModalEngineInfo').textContent = "Status: Pyodide Python 3 Aktif (WebAssembly)";
          this.log("✅ Pyodide siap! AdaptiveLearningEngine aktif.");
        } catch (err) {
          this.setBadge("JS Fallback", "bg-sky-400");
          document.getElementById('pyModalEngineInfo').textContent = "Status: Fallback JS Aktif";
          this.log("⚠️ Pyodide gagal dimuat: " + err.message);
        }
      },

      setBadge(text, colorClass) {
        document.getElementById('pyStatusText').textContent = text;
        document.getElementById('pyStatusDot').className = `w-2.5 h-2.5 rounded-full ${colorClass}`;
      },

      resetPlayer(pid) {
        if (this.ready) {
          this.pyodide.runPython(`engine.reset_player("${pid}")`);
          this.log(`Python -> reset_player("${pid}")`);
        } else {
          this.fb[pid] = { level: 1, streak: 0, correct: 0, attempts: 0, score: 0, total_time: 0 };
        }
      },

      generateClassify(pid, grade) {
        if (this.ready) {
          const res = JSON.parse(this.pyodide.runPython(`engine.generate_classify("${pid}", "${grade}")`));
          this.log(`Python -> generate_classify(${pid}, ${grade}) => ${res.left_label} vs ${res.right_label}`);
          return res;
        }
        const c = this.banks.classify[grade] || this.banks.classify["1-2"];
        const items = c.items.map(([text, emoji, target]) => ({ text, emoji, target })).sort(() => Math.random() - 0.5);
        return { type: "classify", question: c.title, left_label: c.left, right_label: c.right, hint: c.hint, items, level: this.fb[pid].level };
      },

      generateQuestion(pid, grade, subject) {
        if (this.ready) {
          const res = JSON.parse(this.pyodide.runPython(`engine.generate_question("${pid}", "${grade}", "${subject}")`));
          this.log(`Python -> generate_question(${pid}, ${grade}, ${subject}) => Lv.${res.level} [${res.subject}]`);
          return res;
        }
        const st = this.fb[pid];
        const chosen = subject === "campuran" ? ["matematika", "ipa", "inggris"][Math.floor(Math.random() * 3)] : subject;
        if (chosen === "ipa" || chosen === "inggris") {
          const item = (this.banks[chosen][grade] || this.banks[chosen]["1-2"])[0];
          const opts = [{ text: item.ans, emoji: item.emoji, correct: true }, ...item.opts.map(o => ({ text: o[0], emoji: o[1], correct: false }))].sort(() => Math.random() - 0.5);
          return { type: "quiz", question: item.q, hint: item.hint, exp: item.exp, options: opts, level: st.level, subject: chosen.toUpperCase() };
        }
        const a = 2 + Math.floor(Math.random() * (4 + st.level * 3));
        const b = 1 + Math.floor(Math.random() * (4 + st.level * 2));
        const ans = grade === "1-2" ? a + b : a * b;
        const q = grade === "1-2" ? `Berapakah hasil dari ${a} + ${b} ?` : `Berapakah hasil dari ${a} × ${b} ?`;
        const wrongs = new Set();
        while (wrongs.size < 3) {
          const cand = Math.max(0, ans + [-3, -2, -1, 1, 2, 3][Math.floor(Math.random() * 6)]);
          if (cand !== ans) wrongs.add(cand);
        }
        const opts = [{ text: String(ans), emoji: "🌟", correct: true }, ...[...wrongs].map(w => ({ text: String(w), emoji: "🎈", correct: false }))].sort(() => Math.random() - 0.5);
        return { type: "quiz", question: q, hint: "Hitung perlahan ya!", exp: `Hasilnya adalah ${ans}.`, options: opts, level: st.level, subject: "Matematika" };
      },

      recordAnswer(pid, isCorrect, sec) {
        if (this.ready) {
          const res = JSON.parse(this.pyodide.runPython(`engine.record_answer("${pid}", ${isCorrect ? "True" : "False"}, ${sec.toFixed(2)})`));
          this.log(`Python -> record_answer(${pid}, ${isCorrect}, ${sec.toFixed(1)}s) => Skor:${res.state.score}, Lv:${res.state.level}`);
          return res;
        }
        const st = this.fb[pid];
        st.attempts++; st.total_time += sec;
        let level_up = false, feedback = "";
        if (isCorrect) {
          st.correct++; st.streak++;
          st.score += 100 * st.level + 15;
          if (st.streak >= 2 && st.level < 3) { st.level++; level_up = true; feedback = `Hebat! Naik Level ${st.level}!`; }
          else feedback = "Benar sekali! 🎉";
        } else {
          st.streak = 0; if (st.level > 1) st.level--;
          feedback = "Belum tepat, coba lagi ya!";
        }
        return { state: st, accuracy: Math.round((st.correct / Math.max(1, st.attempts)) * 100), feedback, level_up };
      },

      getSummary(pid, grade, subject) {
        if (this.ready) {
          return JSON.parse(this.pyodide.runPython(`engine.get_summary("${pid}", "${grade}", "${subject}")`));
        }
        const st = this.fb[pid];
        const acc = Math.round((st.correct / Math.max(1, st.attempts)) * 100);
        const avg_time = Number((st.total_time / Math.max(1, st.attempts)).toFixed(1));
        const stars = acc >= 85 ? 3 : acc >= 60 ? 2 : 1;
        return { score: st.score, accuracy: acc, avg_time, level: st.level, stars, recommendation: `Akurasi ${acc}% (reaksi ${avg_time}d) di Level ${st.level}. Terus semangat belajar!` };
      }
    };

    /*************************************************************************
     * 3. WEB AUDIO API SFX & INDONESIAN WEB SPEECH API
     *************************************************************************/
    const AudioFX = {
      ctx: null,
      muted: false,
      ensure() {
        if (!this.ctx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) this.ctx = new AC();
        }
        if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
      },
      tone(freq, type, dur, vol = 0.13, delay = 0) {
        if (this.muted) return;
        this.ensure();
        if (!this.ctx) return;
        const now = this.ctx.currentTime + delay;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, now);
        gain.gain.setValueAtTime(0.001, now);
        gain.gain.exponentialRampToValueAtTime(vol, now + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.001, now + dur);
        osc.connect(gain); gain.connect(this.ctx.destination);
        osc.start(now); osc.stop(now + dur + 0.02);
      },
      hover() { this.tone(520, 'sine', 0.06, 0.05); },
      pinch() { this.tone(660, 'sine', 0.10, 0.12); this.tone(920, 'triangle', 0.08, 0.08, 0.03); },
      release() { this.tone(410, 'sine', 0.08, 0.07); },
      correct() {
        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => this.tone(f, 'triangle', 0.22, 0.15, i * 0.08));
      },
      levelUp() {
        [587.33, 783.99, 987.77, 1174.66].forEach((f, i) => this.tone(f, 'sine', 0.26, 0.16, i * 0.09));
      },
      wrong() { this.tone(230, 'sine', 0.16, 0.10, 0); this.tone(185, 'sine', 0.20, 0.09, 0.11); },
      victory() { [523, 659, 784, 1046, 784, 1046].forEach((f, i) => this.tone(f, 'triangle', 0.22, 0.15, i * 0.1)); },
      speak(text) {
        if (this.muted || !('speechSynthesis' in window) || !text) return;
        try {
          window.speechSynthesis.cancel();
          const u = new SpeechSynthesisUtterance(text);
          u.lang = 'id-ID'; u.rate = 0.98; u.pitch = 1.08;
          window.speechSynthesis.speak(u);
        } catch (e) {}
      }
    };

