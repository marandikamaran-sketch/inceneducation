    document.getElementById('btnCloseEval').addEventListener('click', () => { document.getElementById('evalModal').classList.add('hidden'); document.getElementById('evalModal').classList.remove('flex'); });
    document.getElementById('btnClearHistory').addEventListener('click', () => { localStorage.removeItem('eduvision_pro_rapor'); renderRaporHistory(); showToast('🗑️ Riwayat Rapor dihapus.'); });
    document.getElementById('btnPlayAgain').addEventListener('click', () => { AudioFX.pinch(); startSession(); });
    document.getElementById('btnBackLobby').addEventListener('click', () => { document.getElementById('evalModal').classList.add('hidden'); document.getElementById('evalModal').classList.remove('flex'); document.getElementById('lobbyModal').classList.remove('hidden'); document.getElementById('gameplayHud').classList.add('hidden'); });
    document.getElementById('btnPythonModal').addEventListener('click', () => { document.getElementById('pythonModal').classList.remove('hidden'); document.getElementById('pythonModal').classList.add('flex'); });
    document.getElementById('btnClosePython').addEventListener('click', () => { document.getElementById('pythonModal').classList.add('hidden'); document.getElementById('pythonModal').classList.remove('flex'); });

    // Boot
    window.addEventListener('load', () => {
      PyBridge.init();
      renderRaporHistory();
      loop();
    });
  </script>
</body>
</html>
