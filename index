    function getPortals() {
      const w = App.w, h = App.h;
      const r = Math.max(46, Math.min(82, Math.min(w, h) * (App.mode === 'single' ? 0.105 : 0.095)));
      if (App.mode === 'single') {
        return [{ id: 'p1', pid: 'p1', x: w * 0.5, y: h * 0.78, r, color: '#38bdf8', label: 'PORTAL JAWABAN' }];
      }
      if (App.mode === 'split') {
        return [
          { id: 'p1', pid: 'p1', x: w * 0.25, y: h * 0.78, r, color: '#38bdf8', label: 'PORTAL P1' },
          { id: 'p2', pid: 'p2', x: w * 0.75, y: h * 0.78, r, color: '#fb923c', label: 'PORTAL P2' }
        ];
      }
      // Mode Klasifikasi (2 Portal Kategori)
      const q = App.players.p1.currentQ;
      return [
        { id: 'left', pid: 'p1', x: w * 0.24, y: h * 0.78, r, color: '#38bdf8', label: q?.left_label || 'KIRI' },
        { id: 'right', pid: 'p1', x: w * 0.76, y: h * 0.78, r, color: '#f472b6', label: q?.right_label || 'KANAN' }
      ];
    }

    function spawnOrbs(pid, qData) {
      App.orbs = App.orbs.filter(o => o.pid !== pid);
      const w = App.w, h = App.h;
      const isSplit = App.mode === 'split';
      const minX = isSplit ? (pid === 'p1' ? 50 : w * 0.5 + 45) : 65;
      const maxX = isSplit ? (pid === 'p1' ? w * 0.5 - 45 : w - 50) : w - 65;
      const spanX = Math.max(100, maxX - minX);
      const orbR = isSplit ? Math.max(34, Math.min(48, w * 0.05)) : Math.max(44, Math.min(60, w * 0.058));

      const list = qData.type === 'classify' ? qData.items : qData.options;
      list.forEach((opt, i) => {
        const col = i % 2;
        const row = Math.floor(i / 2);
        const x = minX + (col === 0 ? spanX * 0.26 : spanX * 0.74) + (Math.random() - 0.5) * 24;
        const y = h * (row === 0 ? 0.37 : 0.55) + (Math.random() - 0.5) * 18;
        App.orbs.push({
          id: `${pid}_${Date.now()}_${i}`,
          pid,
          text: opt.text,
          emoji: opt.emoji,
          correct: !!opt.correct,
          target: opt.target || null,
          x, y,
          vx: (Math.random() - 0.5) * 0.7,
          vy: (Math.random() - 0.5) * 0.5,
          r: orbR,
          phase: Math.random() * Math.PI * 2,
          grabbedBy: null,
          hovered: false,
          shake: 0,
          scale: 0.1
        });
      });
    }

    function spawnParticles(x, y, color, count = 24) {
      const palette = color ? [color, '#ffffff', '#fde047'] : ['#38bdf8', '#34d399', '#fbbf24', '#f472b6', '#ffffff'];
      for (let i = 0; i < count; i++) {
        const ang = Math.random() * Math.PI * 2;
        const spd = 2 + Math.random() * 6;
        App.particles.push({
          x, y, vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd - 1.4,
          size: 3 + Math.random() * 4.5, color: palette[Math.floor(Math.random() * palette.length)], alpha: 1
        });
      }
    }

    function spawnRipple(x, y, color = '#38bdf8') {
      App.ripples.push({ x, y, r: 10, maxR: 75, alpha: 0.9, color });
    }

    function spawnFloatText(x, y, text, color = '#fde047') {
      App.floatTexts.push({ x, y, text, color, alpha: 1, vy: -1.4 });
    }

