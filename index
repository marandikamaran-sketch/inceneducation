<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content="EduVision AR Pro — Media Pembelajaran Spasial 2D Interaktif bergaya Apple VisionOS untuk siswa SD kelas 1-6." />
  <title>EduVision AR Pro — Media Pembelajaran Spasial SD</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Fredoka (Ramah Anak) & Inter (UI VisionOS) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- MediaPipe Hands CDN -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>

  <style>
    :root {
      --glass-border: rgba(255, 255, 255, 0.28);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: 'Inter', sans-serif;
      background: #090d1e;
      color: #ffffff;
      touch-action: none;
    }

    .font-kids {
      font-family: 'Fredoka', 'Inter', sans-serif;
    }

    /* Apple VisionOS Spatial Glassmorphism */
    .vision-glass {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.08) 100%);
      backdrop-filter: blur(22px) saturate(165%);
      -webkit-backdrop-filter: blur(22px) saturate(165%);
      border: 1.5px solid var(--glass-border);
      box-shadow:
        0 10px 32px rgba(0, 0, 0, 0.34),
        inset 0 1px 1px rgba(255, 255, 255, 0.45);
    }

    .vision-glass-dark {
      background: linear-gradient(145deg, rgba(14, 20, 40, 0.80) 0%, rgba(10, 14, 30, 0.72) 100%);
      backdrop-filter: blur(28px) saturate(155%);
      -webkit-backdrop-filter: blur(28px) saturate(155%);
      border: 1.5px solid rgba(255, 255, 255, 0.24);
      box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.58),
        inset 0 1px 1px rgba(255, 255, 255, 0.30);
    }

    .vision-btn {
      transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), background 0.2s, box-shadow 0.2s;
    }
    .vision-btn:hover {
      transform: translateY(-2px) scale(1.02);
    }
    .vision-btn:active {
      transform: scale(0.96);
    }

    /* Mirrored Webcam Video */
    #webcamVideo {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
      z-index: 1;
      opacity: 0;
      transition: opacity 0.6s ease;
    }
    #webcamVideo.active {
      opacity: 1;
    }

    /* 60fps Spatial 2D AR Canvas */
    #arCanvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      display: block;
      cursor: grab;
    }
    #arCanvas:active {
      cursor: grabbing;
    }

    /* HUD Overlay Layer */
    #hudLayer {
      position: fixed;
      inset: 0;
      z-index: 10;
      pointer-events: none;
    }
    #hudLayer .interactive {
      pointer-events: auto;
    }

    /* Custom Scrollbar */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.06);
      border-radius: 999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.28);
      border-radius: 999px;
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 18px rgba(56, 189, 248, 0.45); }
      50% { box-shadow: 0 0 32px rgba(56, 189, 248, 0.85); }
    }
    .pulse-glow {
      animation: pulseGlow 2.4s infinite ease-in-out;
    }

    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.92) translateY(12px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    .pop-in {
      animation: popIn 0.32s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
  </style>
</head>
<body>

  <!-- Background Mirrored Webcam Feed -->
  <video id="webcamVideo" playsinline autoplay muted aria-label="Tampilan Kamera AR"></video>

  <!-- Main 2D Spatial AR Canvas -->
  <canvas id="arCanvas" aria-label="Kanvas Pembelajaran Interaktif EduVision AR Pro"></canvas>

  <!-- HUD Overlay Layer -->
  <div id="hudLayer" class="flex flex-col justify-between p-2 sm:p-4">

    <!-- Top Control Bar -->
    <header class="w-full flex flex-wrap items-center justify-between gap-2">
      <!-- Left: Brand & Python Engine Status -->
      <div class="flex items-center gap-1.5 sm:gap-2 interactive">
        <button id="btnMenu" title="Kembali ke Menu Utama" class="vision-glass vision-btn flex items-center gap-1.5 px-3 py-2 rounded-full text-xs sm:text-sm font-semibold">
          <span class="text-base sm:text-lg leading-none">🥽</span>
          <span class="font-kids tracking-wide hidden sm:inline">EduVision Pro</span>
        </button>

        <!-- Pyodide Status Badge -->
        <button id="btnPythonModal" title="Inspeksi Mesin Python Adaptif" class="vision-glass vision-btn flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-full text-[11px] sm:text-xs font-medium">
          <span id="pyStatusDot" class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span id="pyStatusText">Python...</span>
        </button>

        <!-- Theme Switcher Button -->
        <button id="btnCycleTheme" title="Ganti Dunia Tema Virtual" class="vision-glass vision-btn flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-full text-[11px] sm:text-xs font-medium">
          <span id="themeIcon">🌌</span>
          <span id="themeLabel" class="hidden md:inline">Luar Angkasa</span>
        </button>
      </div>

      <!-- Right: Controls -->
      <nav class="flex items-center gap-1.5 interactive" aria-label="Kontrol Permainan">
        <button id="btnToggleCamera" class="vision-glass vision-btn px-2.5 sm:px-3 py-2 rounded-full text-xs font-medium flex items-center gap-1.5" title="Ganti Kamera AR / Dunia Virtual">
          <span id="camIcon">📷</span>
          <span id="camLabel" class="hidden lg:inline">Kamera AR</span>
        </button>

        <button id="btnSpeakQ" class="vision-glass vision-btn px-2.5 sm:px-3 py-2 rounded-full text-xs font-medium hidden items-center gap-1" title="Baca Soal Sekarang">
          <span>🗣️</span>
          <span class="hidden lg:inline">Baca</span>
        </button>

        <button id="btnHint" class="vision-glass vision-btn px-2.5 sm:px-3 py-2 rounded-full text-xs font-medium hidden items-center gap-1" title="Petunjuk & Pembahasan">
          <span>💡</span>
          <span class="hidden md:inline">Petunjuk</span>
        </button>

        <button id="btnSettings" class="vision-glass vision-btn px-2.5 py-2 rounded-full text-xs font-medium" title="Pengaturan Sensitivitas & Magnet">
          ⚙️
        </button>

        <button id="btnRaporTop" class="vision-glass vision-btn px-2.5 py-2 rounded-full text-xs font-medium" title="Lihat Rapor Mini & Riwayat">
          📊
        </button>

        <button id="btnSound" class="vision-glass vision-btn px-2.5 py-2 rounded-full text-xs font-medium" title="Suara & Pembaca Otomatis">
          <span id="soundIcon">🔊</span>
        </button>

        <button id="btnReset" class="vision-glass vision-btn px-2.5 py-2 rounded-full text-xs font-medium hidden" title="Ulangi Ronde">
          🔄
        </button>
      </nav>
    </header>

    <!-- In-Game Question & Score Panels -->
    <main id="gameplayHud" class="w-full flex-1 flex flex-col justify-start mt-2 hidden">
      <!-- Single-Screen & Classification HUD -->
      <section id="singleHud" class="w-full max-w-2xl mx-auto hidden">
        <div class="vision-glass-dark rounded-3xl px-4 py-3 sm:px-6 sm:py-4 text-center relative">
          <div class="flex flex-wrap items-center justify-between gap-1 text-[11px] sm:text-xs text-sky-200 mb-1.5">
            <span id="s1Progress" class="font-semibold bg-white/10 px-2.5 py-0.5 rounded-full">Soal 1 / 5</span>
            <span id="s1Combo" class="font-bold text-emerald-300 bg-emerald-500/20 px-2.5 py-0.5 rounded-full hidden">🔥 Combo x2</span>
            <span id="s1Level" class="font-semibold bg-indigo-500/30 border border-indigo-300/30 px-2.5 py-0.5 rounded-full">Level 1</span>
            <span id="s1Score" class="font-bold text-amber-300 bg-amber-500/20 px-2.5 py-0.5 rounded-full">⭐ 0</span>
          </div>
          <!-- Progress Bar -->
          <div class="w-full h-1.5 bg-white/15 rounded-full overflow-hidden mb-2">
            <div id="s1ProgressBar" class="h-full bg-gradient-to-r from-sky-400 via-indigo-400 to-emerald-400 transition-all duration-500" style="width: 20%"></div>
          </div>
          <h2 id="s1Question" class="font-kids text-base sm:text-2xl font-bold text-white leading-snug drop-shadow">
            Memuat soal...
          </h2>
          <p id="s1SubHint" class="text-[11px] sm:text-xs text-sky-200/90 mt-1">
            Cubit / seret gelembung jawaban ke dalam Portal!
          </p>
        </div>
      </section>

      <!-- Split-Screen Duel HUD (2 Players) -->
      <section id="splitHud" class="w-full grid grid-cols-2 gap-2 sm:gap-4 hidden">
        <!-- Player 1 (Left - Blue) -->
        <div class="vision-glass-dark rounded-2xl sm:rounded-3xl p-2.5 sm:p-4 border-sky-400/50 text-center">
          <div class="flex items-center justify-between text-[10px] sm:text-xs mb-1">
            <span class="font-bold text-sky-300">🔵 P1</span>
            <span id="p1Progress" class="bg-white/10 px-2 py-0.5 rounded-full">1/5</span>
            <span id="p1Score" class="font-bold text-amber-300">⭐ 0</span>
          </div>
          <h2 id="p1Question" class="font-kids text-xs sm:text-lg font-bold text-white leading-tight">
            Memuat soal P1...
          </h2>
        </div>

        <!-- Player 2 (Right - Orange) -->
        <div class="vision-glass-dark rounded-2xl sm:rounded-3xl p-2.5 sm:p-4 border-orange-400/50 text-center">
          <div class="flex items-center justify-between text-[10px] sm:text-xs mb-1">
            <span class="font-bold text-orange-300">🟠 P2</span>
            <span id="p2Progress" class="bg-white/10 px-2 py-0.5 rounded-full">1/5</span>
            <span id="p2Score" class="font-bold text-amber-300">⭐ 0</span>
          </div>
          <h2 id="p2Question" class="font-kids text-xs sm:text-lg font-bold text-white leading-tight">
            Memuat soal P2...
          </h2>
        </div>
      </section>
    </main>

    <!-- Bottom Feedback Toast & Gesture Guide -->
    <footer class="w-full flex flex-col items-center gap-1.5 pb-1">
      <div id="toastBanner" role="status" aria-live="polite" class="vision-glass-dark px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold text-center opacity-0 transition-opacity duration-300 max-w-xl">
        Siap bermain!
      </div>
      <div class="vision-glass px-3.5 py-1.5 rounded-full text-[10px] sm:text-xs text-white/90 flex items-center gap-2.5">
        <span>🤏 <b>Cubit udara</b> (ibu jari + telunjuk)</span>
        <span class="opacity-40">|</span>
        <span>🧲 Magnet: <b id="magnetBadge">Aktif</b></span>
        <span class="hidden sm:inline opacity-40">|</span>
        <span class="hidden sm:inline">🖱️ / 👆 Mouse & Sentuh</span>
      </div>
    </footer>
  </div>

  <!-- LOBBY / START MODAL -->
  <div id="lobbyModal" class="fixed inset-0 z-30 flex items-center justify-center p-3 sm:p-5 bg-slate-950/60 backdrop-blur-md">
    <div class="vision-glass-dark pop-in w-full max-w-2xl rounded-[2rem] p-5 sm:p-7 max-h-[94vh] overflow-y-auto custom-scroll">
      <div class="text-center mb-4">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-sky-400 via-indigo-500 to-fuchsia-500 shadow-lg mb-2 text-3xl">
          🥽
        </div>
        <h1 class="font-kids text-2xl sm:text-3xl font-bold bg-gradient-to-r from-sky-300 via-white to-amber-200 bg-clip-text text-transparent">
          EduVision AR Pro
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 mt-0.5">
          Media Pembelajaran Spasial 2D Interaktif SD Kelas 1–6
        </p>
      </div>

      <!-- 1. Jenjang Kelas -->
      <div class="mb-3.5">
        <label class="block text-[11px] font-bold uppercase tracking-wider text-sky-300 mb-1.5">1. Pilih Jenjang Kelas</label>
        <div class="grid grid-cols-3 gap-2">
          <button data-grade="1-2" class="grade-btn vision-btn rounded-2xl py-2 px-2 text-center border border-sky-400 bg-sky-500/30 font-semibold text-xs sm:text-sm">
            <div class="text-base sm:text-lg">🐣</div>
            <div>Kelas 1–2</div>
          </button>
          <button data-grade="3-4" class="grade-btn vision-btn rounded-2xl py-2 px-2 text-center border border-white/20 bg-white/10 font-semibold text-xs sm:text-sm">
            <div class="text-base sm:text-lg">🚀</div>
            <div>Kelas 3–4</div>
          </button>
          <button data-grade="5-6" class="grade-btn vision-btn rounded-2xl py-2 px-2 text-center border border-white/20 bg-white/10 font-semibold text-xs sm:text-sm">
            <div class="text-base sm:text-lg">🪐</div>
            <div>Kelas 5–6</div>
          </button>
        </div>
      </div>

      <!-- 2. Mata Pelajaran -->
      <div class="mb-3.5">
        <label class="block text-[11px] font-bold uppercase tracking-wider text-sky-300 mb-1.5">2. Pilih Mata Pelajaran</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <button data-subject="matematika" class="subject-btn vision-btn rounded-2xl py-2 px-2 text-center border border-white/20 bg-white/10 font-semibold text-xs">
            🔢 Matematika
          </button>
          <button data-subject="ipa" class="subject-btn vision-btn rounded-2xl py-2 px-2 text-center border border-white/20 bg-white/10 font-semibold text-xs">
            🌿 IPA Sains
          </button>
          <button data-subject="inggris" class="subject-btn vision-btn rounded-2xl py-2 px-2 text-center border border-white/20 bg-white/10 font-semibold text-xs">
            🇬🇧 B. Inggris
          </button>
          <button data-subject="campuran" class="subject-btn vision-btn rounded-2xl py-2 px-2 text-center border border-sky-400 bg-sky-500/30 font-semibold text-xs">
            ✨ Campuran
          </button>
        </div>
      </div>

      <!-- 3. Mode Permainan & Layar -->
      <div class="mb-3.5">
        <label class="block text-[11px] font-bold uppercase tracking-wider text-sky-300 mb-1.5">3. Pilih Mode Permainan</label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <button data-mode="single" class="mode-btn vision-btn rounded-2xl p-2.5 text-left border border-sky-400 bg-sky-500/30">
            <div class="font-bold text-xs sm:text-sm">👤 Single-Screen</div>
            <div class="text-[11px] text-slate-200 mt-0.5">1 Anak, 1 Portal Jawaban</div>
          </button>
          <button data-mode="split" class="mode-btn vision-btn rounded-2xl p-2.5 text-left border border-white/20 bg-white/10">
            <div class="font-bold text-xs sm:text-sm">👥 Split-Screen Duel</div>
            <div class="text-[11px] text-slate-200 mt-0.5">2 Anak berlomba (Kiri vs Kanan)</div>
          </button>
          <button data-mode="classify" class="mode-btn vision-btn rounded-2xl p-2.5 text-left border border-white/20 bg-white/10">
            <div class="font-bold text-xs sm:text-sm">🗂️ Mode Klasifikasi</div>
            <div class="text-[11px] text-slate-200 mt-0.5">Pilah objek ke 2 Portal Kategori</div>
          </button>
        </div>
      </div>

      <!-- 4. Dunia Tema Virtual -->
      <div class="mb-5">
        <label class="block text-[11px] font-bold uppercase tracking-wider text-sky-300 mb-1.5">4. Pilih Dunia Tema (Mode Virtual)</label>
        <div class="grid grid-cols-3 gap-2">
          <button data-theme="space" class="theme-btn vision-btn rounded-2xl py-2 px-2 text-center border border-sky-400 bg-sky-500/30 font-semibold text-xs">
            🌌 Luar Angkasa
          </button>
          <button data-theme="ocean" class="theme-btn vision-btn rounded-2xl py-2 px-2 text-center border border-white/20 bg-white/10 font-semibold text-xs">
            🐠 Bawah Laut
          </button>
          <button data-theme="forest" class="theme-btn vision-btn rounded-2xl py-2 px-2 text-center border border-white/20 bg-white/10 font-semibold text-xs">
            🧚 Hutan Ajaib
          </button>
        </div>
      </div>

      <!-- Tombol Mulai -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <button id="btnStartCamera" class="vision-btn pulse-glow w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-600 font-kids font-bold text-base shadow-lg flex items-center justify-center gap-2">
          <span>📷</span> Mulai dengan Kamera AR
        </button>
        <button id="btnStartVirtual" class="vision-btn w-full py-3.5 px-4 rounded-2xl bg-white/15 hover:bg-white/25 border border-white/25 font-kids font-bold text-base flex items-center justify-center gap-2">
          <span>🌌</span> Mulai Dunia Virtual 2D
        </button>
      </div>
    </div>
  </div>

  <!-- SETTINGS MODAL (Sensitivitas Cubitan & Magnet Assist) -->
  <div id="settingsModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/65 backdrop-blur-md">
    <div class="vision-glass-dark pop-in w-full max-w-md rounded-[2rem] p-5 sm:p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-kids text-lg font-bold flex items-center gap-2">⚙️ Pengaturan Kontrol Spasial</h3>
        <button id="btnCloseSettings" class="vision-btn w-8 h-8 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center font-bold">✕</button>
      </div>

      <div class="space-y-4">
        <!-- Magnet Assist Toggle -->
        <div class="flex items-center justify-between bg-white/10 rounded-2xl p-3.5">
          <div>
            <div class="font-semibold text-sm">🧲 Magnet Assist</div>
            <div class="text-xs text-slate-300">Bantu anak SD menangkap gelembung terdekat</div>
          </div>
          <button id="btnToggleMagnet" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500 text-white">AKTIF</button>
        </div>

        <!-- Pinch Sensitivity Slider -->
        <div class="bg-white/10 rounded-2xl p-3.5">
          <div class="flex items-center justify-between mb-1.5">
            <label for="pinchSlider" class="font-semibold text-sm">🤏 Sensitivitas Cubitan</label>
            <span id="pinchValLabel" class="text-xs font-bold text-sky-300">Normal (52px)</span>
          </div>
          <input id="pinchSlider" type="range" min="32" max="85" value="52" class="w-full accent-sky-400 cursor-pointer" />
          <div class="flex justify-between text-[10px] text-slate-300 mt-1">
            <span>Ketat (32px)</span>
            <span>Sangat Mudah (85px)</span>
          </div>
        </div>

        <!-- Hand Skeleton Toggle -->
        <div class="flex items-center justify-between bg-white/10 rounded-2xl p-3.5">
          <div>
            <div class="font-semibold text-sm">🖐️ Kerangka Tangan Hologram</div>
            <div class="text-xs text-slate-300">Tampilkan garis tangan VisionOS di layar</div>
          </div>
          <button id="btnToggleSkeleton" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500 text-white">AKTIF</button>
        </div>
      </div>
    </div>
  </div>

  <!-- RAPOR MINI & EVALUATION MODAL -->
  <div id="evalModal" class="fixed inset-0 z-40 hidden items-center justify-center p-4 bg-slate-950/70 backdrop-blur-md">
    <div class="vision-glass-dark pop-in w-full max-w-lg rounded-[2rem] p-5 sm:p-6 text-center max-h-[92vh] overflow-y-auto custom-scroll">
      <div class="flex justify-end">
        <button id="btnCloseEval" class="vision-btn w-8 h-8 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center font-bold text-xs">✕</button>
      </div>
      <div id="evalStars" class="text-4xl sm:text-5xl mb-1 tracking-widest">⭐⭐⭐</div>
      <h2 id="evalTitle" class="font-kids text-2xl sm:text-3xl font-bold text-white">Rapor Mini Belajar</h2>
      <p id="evalSubtitle" class="text-xs sm:text-sm text-sky-200 mt-0.5">Ringkasan performa sesi terakhir</p>

      <!-- 4 Metric Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 my-4">
        <div class="bg-white/10 rounded-2xl p-2.5">
          <div class="text-[11px] text-slate-300">Skor</div>
          <div id="evalScore" class="font-kids text-xl font-bold text-amber-300">0</div>
        </div>
        <div class="bg-white/10 rounded-2xl p-2.5">
          <div class="text-[11px] text-slate-300">Akurasi</div>
          <div id="evalAccuracy" class="font-kids text-xl font-bold text-emerald-300">0%</div>
        </div>
        <div class="bg-white/10 rounded-2xl p-2.5">
          <div class="text-[11px] text-slate-300">Reaksi</div>
          <div id="evalReaction" class="font-kids text-xl font-bold text-sky-300">0.0d</div>
        </div>
        <div class="bg-white/10 rounded-2xl p-2.5">
          <div class="text-[11px] text-slate-300">Level</div>
          <div id="evalLevel" class="font-kids text-xl font-bold text-fuchsia-300">Lv 1</div>
        </div>
      </div>

      <!-- Python Pedagogical Recommendation -->
      <div class="bg-indigo-950/60 border border-indigo-400/35 rounded-2xl p-3.5 text-left mb-4">
        <div class="text-[11px] font-bold uppercase tracking-wider text-indigo-300 mb-1 flex items-center gap-1.5">
          <span>🐍</span> Analisis Mesin Python Adaptif
        </div>
        <p id="evalRecommendation" class="text-xs sm:text-sm text-slate-100 leading-relaxed">
          Belum ada sesi selesai. Mulai bermain untuk melihat analisis belajarmu!
        </p>
