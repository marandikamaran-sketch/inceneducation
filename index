    function bindGroup(sel, attr, key, cb) {
      document.querySelectorAll(sel).forEach(btn => {
        btn.addEventListener('click', () => {
          AudioFX.pinch();
          App[key] = btn.getAttribute(attr);
          document.querySelectorAll(sel).forEach(b => {
            b.classList.remove('border-sky-400', 'bg-sky-500/30');
            b.classList.add('border-white/20', 'bg-white/10');
          });
          btn.classList.remove('border-white/20', 'bg-white/10');
          btn.classList.add('border-sky-400', 'bg-sky-500/30');
          if (cb) cb(App[key]);
        });
      });
    }

