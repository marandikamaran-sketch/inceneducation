      App.orbs = []; App.particles = []; App.ripples = []; App.floatTexts = [];
      ['p1', 'p2'].forEach(pid => {
        PyBridge.resetPlayer(pid);
        App.players[pid] = { qIndex: 0, currentQ: null, qStart: 0, done: false, score: 0, level: 1, streak: 0 };
      });
      App.running = true;
      loadNext('p1');
      if (App.mode === 'split') loadNext('p2');
    }

    /*************************************************************************
     * 7. WEBCAM & MEDIAPIPE HANDS (HOLOGRAPHIC SKELETON + PINCH)
     *************************************************************************/
    async function enableCamera() {
      try {
        if (!navigator.mediaDevices?.getUserMedia) throw new Error("No camera API");
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } }, audio: false
        });
        App.cameraStream = stream;
        videoEl.srcObject = stream;
        await videoEl.play();
        videoEl.classList.add('active');
        App.cameraActive = true;
        document.getElementById('camIcon').textContent = '📷';
        document.getElementById('camLabel').textContent = 'Kamera AR';
        showToast("📷 Kamera AR Aktif! Cubit udara untuk menangkap jawaban.");
        initMediaPipe();
      } catch (e) {
        disableCamera();
        showToast("🌌 Kamera tidak tersedia — Mode Dunia Virtual 2D Aktif.", 3400);
      }
    }

    function disableCamera() {
      if (App.cameraStream) { App.cameraStream.getTracks().forEach(t => t.stop()); App.cameraStream = null; }
      videoEl.classList.remove('active'); videoEl.srcObject = null;
      App.cameraActive = false; App.handCursors = []; App.rawHandLandmarks = [];
      document.getElementById('camIcon').textContent = '🌌';
      document.getElementById('camLabel').textContent = 'Virtual 2D';
    }

    function initMediaPipe() {
      if (App.handsDetector || typeof Hands === 'undefined') return;
      try {
        const hands = new Hands({ locateFile: f => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${f}` });
        hands.setOptions({ maxNumHands: 2, modelComplexity: 1, minDetectionConfidence: 0.65, minTrackingConfidence: 0.6 });
        hands.onResults(onHandsResults);
        App.handsDetector = hands;
        pumpVideo();
      } catch (e) {}
    }

    async function pumpVideo() {
      if (App.cameraActive && App.handsDetector && videoEl.readyState >= 2 && !App.handsBusy) {
        App.handsBusy = true;
        try { await App.handsDetector.send({ image: videoEl }); } catch (e) {}
        App.handsBusy = false;
      }
      requestAnimationFrame(pumpVideo);
    }

    function onHandsResults(res) {
      const prevMap = new Map(App.handCursors.map(c => [c.id, c]));
      const next = [];
      App.rawHandLandmarks = res.multiHandLandmarks || [];

      App.rawHandLandmarks.forEach((lm, idx) => {
        const thumb = lm[4], index = lm[8];
        const mx = (1 - (thumb.x + index.x) / 2) * App.w;
        const my = ((thumb.y + index.y) / 2) * App.h;
        const dist = Math.hypot((thumb.x - index.x) * App.w, (thumb.y - index.y) * App.h);
        const id = `hand_${idx}`;
        const prev = prevMap.get(id);
        const thresh = prev?.pinching ? App.pinchSensitivity + 14 : App.pinchSensitivity;
        const pinching = dist < thresh;

        const cursor = {
          id, x: prev ? prev.x * 0.35 + mx * 0.65 : mx, y: prev ? prev.y * 0.35 + my * 0.65 : my,
          pinching, grabbedOrbId: prev ? prev.grabbedOrbId : null
        };
        processCursor(cursor, prev?.pinching || false);
        next.push(cursor);
      });

      prevMap.forEach((oldC, id) => {
        if (!next.find(c => c.id === id) && oldC.grabbedOrbId) releaseOrb(oldC.grabbedOrbId);
      });
      App.handCursors = next;
    }

    /*************************************************************************
     * 8. UNIFIED CURSOR INTERACTION (HAND + MOUSE + MULTI-TOUCH + MAGNET)
     *************************************************************************/
    function processCursor(cursor, wasPinching) {
      if (!App.running) return;
      const magnetBonus = App.magnetAssist ? 28 : 6;

      if (cursor.pinching && !wasPinching) {
        spawnRipple(cursor.x, cursor.y, '#38bdf8');
        // Cari orb terdekat dalam jangkauan (dengan Magnet Assist)
        let best = null, bestD = Infinity;
        App.orbs.forEach(o => {
          if (o.grabbedBy) return;
          const d = Math.hypot(o.x - cursor.x, o.y - cursor.y);
          if (d <= o.r + magnetBonus && d < bestD) { best = o; bestD = d; }
        });
        if (best) {
          best.grabbedBy = cursor.id;
          cursor.grabbedOrbId = best.id;
          AudioFX.pinch();
          spawnParticles(best.x, best.y, '#38bdf8', 10);
        }
      }

      if (cursor.pinching && cursor.grabbedOrbId) {
        const orb = App.orbs.find(o => o.id === cursor.grabbedOrbId);
        if (orb) {
          orb.x += (cursor.x - orb.x) * 0.48;
          orb.y += (cursor.y - orb.y) * 0.48;
          orb.vx = 0; orb.vy = 0;
          if (Math.random() < 0.3) spawnParticles(orb.x, orb.y, '#bae6fd', 1);
        } else {
          cursor.grabbedOrbId = null;
        }
      }

      if (!cursor.pinching && wasPinching && cursor.grabbedOrbId) {
        releaseOrb(cursor.grabbedOrbId);
        cursor.grabbedOrbId = null;
      }
    }

    function releaseOrb(orbId) {
      const orb = App.orbs.find(o => o.id === orbId);
      if (!orb) return;
      orb.grabbedBy = null;
      const portals = getPortals().filter(pt => App.mode === 'classify' || pt.pid === orb.pid);
      const hitPortal = portals.find(pt => Math.hypot(orb.x - pt.x, orb.y - pt.y) <= pt.r + orb.r * 0.72);
      if (hitPortal) {
        handleDrop(orb, hitPortal);
      } else {
        AudioFX.release();
        orb.vx = (Math.random() - 0.5) * 1.0;
        orb.vy = (Math.random() - 0.5) * 0.8;
      }
    }

    canvas.addEventListener('pointerdown', (e) => {
      canvas.setPointerCapture(e.pointerId);
      const c = { id: `ptr_${e.pointerId}`, x: e.clientX, y: e.clientY, pinching: true, grabbedOrbId: null };
      processCursor(c, false);
      App.pointerCursors.set(e.pointerId, c);
    });
    canvas.addEventListener('pointermove', (e) => {
      App.hoverPos = { x: e.clientX, y: e.clientY };
      const c = App.pointerCursors.get(e.pointerId);
      if (!c) return;
      c.x = e.clientX; c.y = e.clientY;
      processCursor(c, true);
    });
    function endPtr(e) {
      const c = App.pointerCursors.get(e.pointerId);
      if (!c) return;
      c.pinching = false;
      processCursor(c, true);
      App.pointerCursors.delete(e.pointerId);
    }
    canvas.addEventListener('pointerup', endPtr);
    canvas.addEventListener('pointercancel', endPtr);

    /*************************************************************************
     * 9. 60FPS SPATIAL 2D RENDERER (3 THEMES + SKELETON + ORBS + PORTALS)
     *************************************************************************/
    function drawVirtualTheme() {
      const w = App.w, h = App.h;
      const g = ctx.createLinearGradient(0, 0, w, h);

      if (App.theme === 'space') {
        g.addColorStop(0, '#090d1e'); g.addColorStop(0.5, '#1e1b4b'); g.addColorStop(1, '#0c4a6e');
        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
        // Planet 2D Parallax
        ctx.save();
        ctx.fillStyle = 'rgba(251, 146, 60, 0.18)';
        ctx.beginPath(); ctx.arc(w * 0.14, h * 0.24, 52, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = 'rgba(253, 224, 71, 0.28)'; ctx.lineWidth = 5;
        ctx.beginPath(); ctx.ellipse(w * 0.14, h * 0.24, 85, 18, -0.25, 0, Math.PI * 2); ctx.stroke();
        ctx.restore();
        // Stars
        App.themeEntities.forEach(s => {
          s.y -= s.vy * 0.5; if (s.y < -5) { s.y = h + 5; s.x = Math.random() * w; }
          ctx.fillStyle = `rgba(255,255,255,${0.35 + 0.45 * Math.sin(App.t * 2 + s.phase)})`;
          ctx.beginPath(); ctx.arc(s.x, s.y, s.r * 0.65, 0, Math.PI * 2); ctx.fill();
        });
      } else if (App.theme === 'ocean') {
        g.addColorStop(0, '#082f49'); g.addColorStop(0.5, '#0e7490'); g.addColorStop(1, '#042f2e');
        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
        // Rising Bubbles & 2D Vector Fish
        App.themeEntities.forEach((b, i) => {
          if (i % 8 === 0) {
            b.x += 1.1; if (b.x > w + 40) { b.x = -40; b.y = h * (0.2 + Math.random() * 0.6); }
            ctx.save(); ctx.translate(b.x, b.y + Math.sin(App.t * 3 + b.phase) * 8);
            ctx.fillStyle = 'rgba(253, 224, 71, 0.35)';
            ctx.beginPath(); ctx.ellipse(0, 0, 16, 9, 0, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.moveTo(-14, 0); ctx.lineTo(-24, -8); ctx.lineTo(-24, 8); ctx.closePath(); ctx.fill();
            ctx.restore();
          } else {
            b.y -= b.vy * 1.1; if (b.y < -10) { b.y = h + 10; b.x = Math.random() * w; }
            ctx.strokeStyle = 'rgba(186, 230, 253, 0.35)'; ctx.lineWidth = 1.5;
            ctx.beginPath(); ctx.arc(b.x + Math.sin(App.t + b.phase) * 6, b.y, b.r * 1.4, 0, Math.PI * 2); ctx.stroke();
          }
        });
      } else {
        // Hutan Ajaib
        g.addColorStop(0, '#052e16'); g.addColorStop(0.55, '#064e3b'); g.addColorStop(1, '#1e1b4b');
        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
        App.themeEntities.forEach((f, i) => {
          f.x += Math.sin(App.t + f.phase) * 0.7; f.y -= f.vy * 0.4;
          if (f.y < -10) { f.y = h + 10; f.x = Math.random() * w; }
          ctx.fillStyle = i % 3 === 0 ? 'rgba(163, 230, 53, 0.65)' : 'rgba(253, 224, 71, 0.55)';
          ctx.shadowColor = '#bef264'; ctx.shadowBlur = 10;
          ctx.beginPath(); ctx.arc(f.x, f.y, f.r * 0.9, 0, Math.PI * 2); ctx.fill();
          ctx.shadowBlur = 0;
        });
      }
    }

    function drawHandSkeletons() {
      if (!App.showSkeleton || !App.rawHandLandmarks.length) return;
      ctx.save();
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.55)';
      ctx.lineWidth = 2;
      App.rawHandLandmarks.forEach(lm => {
        HAND_CONNECTIONS.forEach(([a, b]) => {
          const ax = (1 - lm[a].x) * App.w, ay = lm[a].y * App.h;
          const bx = (1 - lm[b].x) * App.w, by = lm[b].y * App.h;
          ctx.beginPath(); ctx.moveTo(ax, ay); ctx.lineTo(bx, by); ctx.stroke();
        });
        [4, 8].forEach(idx => {
          ctx.fillStyle = '#34d399';
          ctx.beginPath(); ctx.arc((1 - lm[idx].x) * App.w, lm[idx].y * App.h, 5, 0, Math.PI * 2); ctx.fill();
        });
      });
      ctx.restore();
    }

    function drawPortal(pt) {
      ctx.save();
      ctx.translate(pt.x, pt.y);
      const pulse = 1 + Math.sin(App.t * 3.5) * 0.06;
      const g = ctx.createRadialGradient(0, 0, pt.r * 0.2, 0, 0, pt.r * 1.28 * pulse);
      g.addColorStop(0, pt.color + '55'); g.addColorStop(0.7, pt.color + '22'); g.addColorStop(1, 'transparent');
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(0, 0, pt.r * 1.28 * pulse, 0, Math.PI * 2); ctx.fill();

      ctx.save(); ctx.rotate(App.t * 0.85);
      ctx.strokeStyle = pt.color; ctx.lineWidth = 3.5; ctx.setLineDash([14, 10]);
      ctx.beginPath(); ctx.arc(0, 0, pt.r, 0, Math.PI * 2); ctx.stroke();
      ctx.restore();

      ctx.fillStyle = 'rgba(15, 23, 42, 0.52)';
      ctx.beginPath(); ctx.arc(0, 0, pt.r * 0.85, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#ffffff'; ctx.font = '700 11px Inter, sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('🎯', 0, -10);
      ctx.fillText(pt.label, 0, 12);
      ctx.restore();
    }

    function drawOrbs() {
      const w = App.w, h = App.h, isSplit = App.mode === 'split';
      const activePts = [...App.handCursors, App.hoverPos];

      App.orbs.forEach(o => {
        o.scale += (1 - o.scale) * 0.14;
        if (o.shake > 0) o.shake *= 0.85;

        const isHov = activePts.some(p => Math.hypot(o.x - p.x, o.y - p.y) <= o.r + 14);
        if (isHov && !o.hovered && !o.grabbedBy) AudioFX.hover();
        o.hovered = isHov;

        if (!o.grabbedBy) {
          o.x += o.vx; o.y += o.vy + Math.sin(App.t * 2.4 + o.phase) * 0.36;
          const minX = isSplit ? (o.pid === 'p1' ? o.r + 12 : w * 0.5 + o.r + 12) : o.r + 16;
          const maxX = isSplit ? (o.pid === 'p1' ? w * 0.5 - o.r - 12 : w - o.r - 12) : w - o.r - 16;
          const minY = h * 0.25 + o.r, maxY = h * 0.86 - o.r;
          if (o.x < minX) { o.x = minX; o.vx = Math.abs(o.vx); }
          if (o.x > maxX) { o.x = maxX; o.vx = -Math.abs(o.vx); }
          if (o.y < minY) { o.y = minY; o.vy = Math.abs(o.vy); }
          if (o.y > maxY) { o.y = maxY; o.vy = -Math.abs(o.vy); }
        }

        ctx.save();
        ctx.translate(o.x + (o.shake > 0.5 ? (Math.random() - 0.5) * o.shake : 0), o.y);
        const mult = o.grabbedBy ? 1.14 : (o.hovered ? 1.07 : 1);
        ctx.scale(o.scale * mult, o.scale * mult);

        const accent = o.pid === 'p2' ? '#fb923c' : '#38bdf8';
        const bg = ctx.createRadialGradient(-o.r * 0.3, -o.r * 0.3, o.r * 0.1, 0, 0, o.r);
        bg.addColorStop(0, 'rgba(255,255,255,0.38)');
        bg.addColorStop(0.55, o.grabbedBy ? accent + '99' : 'rgba(30, 41, 72, 0.72)');
        bg.addColorStop(1, o.grabbedBy ? accent + 'cc' : 'rgba(15, 23, 42, 0.88)');

        ctx.shadowColor = o.grabbedBy ? accent : 'rgba(0,0,0,0.45)';
        ctx.shadowBlur = o.grabbedBy ? 28 : 14;
        ctx.fillStyle = bg;
        ctx.beginPath(); ctx.arc(0, 0, o.r, 0, Math.PI * 2); ctx.fill();
        ctx.shadowBlur = 0;
        ctx.strokeStyle = o.grabbedBy || o.hovered ? '#ffffff' : 'rgba(255,255,255,0.45)';
        ctx.lineWidth = o.grabbedBy ? 3.5 : 2;
        ctx.stroke();

        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.font = `${Math.round(o.r * 0.54)}px sans-serif`;
        ctx.fillText(o.emoji, 0, -o.r * 0.24);
        ctx.fillStyle = '#ffffff';
        const fs = o.text.length > 8 ? Math.round(o.r * 0.25) : Math.round(o.r * 0.34);
        ctx.font = `700 ${fs}px Fredoka, Inter, sans-serif`;
        ctx.fillText(o.text, 0, o.r * 0.34);
        ctx.restore();
      });
    }

    function drawEffectsAndCursors() {
      // Ripples
      for (let i = App.ripples.length - 1; i >= 0; i--) {
        const rp = App.ripples[i];
        rp.r += 3.2; rp.alpha -= 0.035;
        if (rp.alpha <= 0) { App.ripples.splice(i, 1); continue; }
        ctx.save(); ctx.globalAlpha = rp.alpha; ctx.strokeStyle = rp.color; ctx.lineWidth = 2.5;
        ctx.beginPath(); ctx.arc(rp.x, rp.y, rp.r, 0, Math.PI * 2); ctx.stroke(); ctx.restore();
      }
      // Particles
      for (let i = App.particles.length - 1; i >= 0; i--) {
        const p = App.particles[i];
        p.x += p.vx; p.y += p.vy; p.vy += 0.14; p.alpha -= 0.025;
        if (p.alpha <= 0) { App.particles.splice(i, 1); continue; }
        ctx.save(); ctx.globalAlpha = p.alpha; ctx.fillStyle = p.color;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill(); ctx.restore();
      }
      // Floating Texts
      for (let i = App.floatTexts.length - 1; i >= 0; i--) {
        const ft = App.floatTexts[i];
        ft.y += ft.vy; ft.alpha -= 0.018;
        if (ft.alpha <= 0) { App.floatTexts.splice(i, 1); continue; }
        ctx.save(); ctx.globalAlpha = ft.alpha; ctx.fillStyle = ft.color;
        ctx.font = '700 20px Fredoka, sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(ft.text, ft.x, ft.y); ctx.restore();
      }
      // Cursors
      [...App.handCursors, ...App.pointerCursors.values()].forEach(c => {
        ctx.save(); ctx.translate(c.x, c.y);
        const r = c.pinching ? 15 : 24;
        ctx.strokeStyle = c.pinching ? '#34d399' : '#38bdf8';
        ctx.lineWidth = c.pinching ? 4 : 2.5;
        ctx.shadowColor = ctx.strokeStyle; ctx.shadowBlur = 14;
        ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.stroke();
        ctx.fillStyle = c.pinching ? 'rgba(52,211,153,0.4)' : 'rgba(56,189,248,0.18)';
        ctx.fill(); ctx.restore();
      });
    }

    function loop() {
      App.t += 0.016;
      ctx.clearRect(0, 0, App.w, App.h);
      if (!App.cameraActive) drawVirtualTheme();
      drawHandSkeletons();
      if (App.running) {
        if (App.mode === 'split') {
          ctx.save(); ctx.strokeStyle = 'rgba(255,255,255,0.45)'; ctx.lineWidth = 3; ctx.setLineDash([12, 10]);
          ctx.beginPath(); ctx.moveTo(App.w * 0.5, 0); ctx.lineTo(App.w * 0.5, App.h); ctx.stroke(); ctx.restore();
        }
        getPortals().forEach(drawPortal);
        drawOrbs();
      }
      drawEffectsAndCursors();
      requestAnimationFrame(loop);
    }

