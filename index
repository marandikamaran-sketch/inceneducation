        objs = [{"text": t, "emoji": e, "target": side} for (t, e, side) in item["items"]]
        random.shuffle(objs)
        return json.dumps({
            "type": "classify",
            "question": item["title"],
            "left_label": item["left"],
            "right_label": item["right"],
            "hint": item["hint"],
            "items": objs,
            "level": st["level"]
        })

    def generate_question(self, pid, grade, subject):
        st = self.states[pid]
        lvl = st["level"]
        chosen = subject
        if subject == "campuran":
            chosen = random.choice(["matematika", "ipa", "inggris"])

        if chosen == "ipa":
            item = random.choice(self.ipa_bank.get(grade, self.ipa_bank["1-2"]))
            opts = [{"text": item["ans"], "emoji": item["emoji"], "correct": True}]
            for txt, emj in item["opts"]:
                opts.append({"text": txt, "emoji": emj, "correct": False})
            random.shuffle(opts)
            return json.dumps({"type": "quiz", "question": item["q"], "hint": item["hint"], "exp": item["exp"], "options": opts, "level": lvl, "subject": "IPA"})

        if chosen == "inggris":
            item = random.choice(self.eng_bank.get(grade, self.eng_bank["1-2"]))
            opts = [{"text": item["ans"], "emoji": item["emoji"], "correct": True}]
            for txt, emj in item["opts"]:
